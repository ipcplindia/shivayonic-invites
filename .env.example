DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>"
OBJECT_STORAGE_DRIVER="local"
LOCAL_MEDIA_STORAGE_PATH=".shivayonic-media"
# Required only when OBJECT_STORAGE_DRIVER="s3".
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_BUCKET="<bucket-name>"
OBJECT_STORAGE_ACCESS_KEY_ID="<access-key-id>"
OBJECT_STORAGE_SECRET_ACCESS_KEY="<secret-access-key>"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
TOKEN_ENCRYPTION_KEY="<managed-secret-value>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="<32-plus-character-managed-auth-secret>"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_BOOTSTRAP_EMAIL="<owner-email>"
ADMIN_BOOTSTRAP_NAME="<owner-name>"
ADMIN_BOOTSTRAP_PASSWORD="<owner-password-entered-only-in-local-env>"
ADMIN_BOOTSTRAP_ORG_NAME="Shivayonic"
ADMIN_BOOTSTRAP_ORG_SLUG="shivayonic"

# Public site
NEXT_PUBLIC_SITE_URL=https://shivayonic.com
# Analytics (leave blank to ship no trackers)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
