generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum MediaKind {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum PublicProductType {
  INVITATION
  VIDEO_INVITATION
  AUDIO_INVITATION
}

enum PublicProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductMediaRole {
  COVER
  GALLERY
  VIDEO_PREVIEW
  AUDIO_PREVIEW
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  emailVerified      Boolean              @default(false)
  image              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  accounts           Account[]
  memberships        OrganizationMember[]
  createdMediaAssets MediaAsset[]         @relation("MediaCreatedBy")
  auditLogs          AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  issuer                String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships OrganizationMember[]
  projects    Project[]
  mediaAssets MediaAsset[]
  auditLogs   AuditLog[]
}

model OrganizationMember {
  userId         String
  organizationId String
  role           OrganizationMemberRole
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId, role])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model MediaAsset {
  id               String           @id @default(cuid())
  organizationId   String
  projectId        String?
  kind             MediaKind
  status           MediaAssetStatus @default(PENDING_UPLOAD)
  originalFilename String
  storageKey       String           @unique
  mimeType         String
  sizeBytes        BigInt
  width            Int?
  height           Int?
  durationMs       Int?
  createdByUserId  String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  archivedAt       DateTime?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("MediaCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publicProductMedia PublicProductMedia[]

  @@index([organizationId, status])
  @@index([projectId])
}

model PublicCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  parentId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    PublicCategory?  @relation("PublicCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  PublicCategory[] @relation("PublicCategoryHierarchy")
  products  PublicProduct[]

  @@index([parentId, active])
}

model VisualStyle {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    PublicProductStyle[]
}

model PublicProduct {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  shortDescription String
  categoryId       String
  productType      PublicProductType
  startingPrice    Int?
  pricingLabel     String?
  currency         String              @default("INR")
  status           PublicProductStatus @default(DRAFT)
  featured         Boolean             @default(false)
  displayOrder     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         PublicCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  styles           PublicProductStyle[]
  media            PublicProductMedia[]
  collections      PublicCollectionProduct[]

  @@index([status, featured, displayOrder])
  @@index([categoryId, status, displayOrder])
}

model PublicProductStyle {
  productId String
  styleId   String
  product   PublicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  style     VisualStyle   @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@id([productId, styleId])
  @@index([styleId])
}

model PublicProductMedia {
  id           String           @id @default(cuid())
  productId    String
  mediaAssetId String
  role         ProductMediaRole
  altText      String?
  displayOrder Int              @default(0)
  product      PublicProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaAssetId, role])
  @@index([productId, role, displayOrder])
}

model PublicCollection {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  shortDescription  String?
  coverMediaAssetId String?
  active            Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  products          PublicCollectionProduct[]

  @@index([active, displayOrder])
}

model PublicCollectionProduct {
  collectionId String
  productId    String
  displayOrder Int               @default(0)
  collection   PublicCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      PublicProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
