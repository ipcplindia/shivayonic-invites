generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum MediaKind {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum WebsitePublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum WebsitePlacement {
  HOMEPAGE_FEATURED
  OUR_WORK_GRID
  FILMS_FEATURED
  MUSIC_SHOWCASE
}

enum PublicProductType {
  INVITATION
  VIDEO_INVITATION
  AUDIO_INVITATION
}

enum PublicProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductMediaRole {
  COVER
  GALLERY
  VIDEO_PREVIEW
  AUDIO_PREVIEW
}

enum ContentItemType {
  VIDEO
  IMAGE
  CAROUSEL
  ARTICLE
  CAMPAIGN_ASSET
}

enum ContentItemStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentDestinationPlatform {
  WEBSITE
  INSTAGRAM
  YOUTUBE
}

enum ContentDestinationStatus {
  DRAFT
  READY
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  DISABLED
}

enum PublishJobStatus {
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

enum IntegrationConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  EXPIRED
  ERROR
  DISABLED
}

enum WebsiteAnalyticsEventType {
  PAGE_VIEW
  CTA_CLICK
  WHATSAPP_CLICK
  FORM_START
  FORM_SUBMIT
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  emailVerified      Boolean              @default(false)
  image              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  accounts           Account[]
  memberships        OrganizationMember[]
  createdMediaAssets MediaAsset[]         @relation("MediaCreatedBy")
  createdContentItems ContentItem[]       @relation("ContentCreatedBy")
  updatedContentItems ContentItem[]       @relation("ContentUpdatedBy")
  createdPublishJobs PublishJob[]         @relation("PublishJobCreatedBy")
  auditLogs          AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  issuer                String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         OrganizationMember[]
  projects            Project[]
  mediaAssets         MediaAsset[]
  websitePublications WebsitePublication[]
  publicCategories    PublicCategory[]
  visualStyles        VisualStyle[]
  publicProducts      PublicProduct[]
  publicPlans         PublicPlan[]
  contentItems        ContentItem[]
  publishJobs         PublishJob[]
  platformPublications PlatformPublication[]
  contentMetricSnapshots ContentMetricSnapshot[]
  integrationConnections IntegrationConnection[]
  websiteAnalyticsEvents WebsiteAnalyticsEvent[]
  auditLogs           AuditLog[]
}

model OrganizationMember {
  userId         String
  organizationId String
  role           OrganizationMemberRole
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId, role])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model MediaAsset {
  id                  String               @id @default(cuid())
  organizationId      String
  projectId           String?
  kind                MediaKind
  status              MediaAssetStatus     @default(PENDING_UPLOAD)
  originalFilename    String
  storageKey          String               @unique
  mimeType            String
  sizeBytes           BigInt
  width               Int?
  height              Int?
  durationMs          Int?
  displayTitle        String?
  altText             String?
  description         String?
  createdByUserId     String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  archivedAt          DateTime?
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("MediaCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publicCategories    PublicCategory[]
  visualStyles        VisualStyle[]
  publicProductCovers PublicProduct[]
  publicPlanMedia     PublicPlan[]
  publicProductMedia  PublicProductMedia[]
  websitePublications WebsitePublication[]
  masterContentItems  ContentItem[]       @relation("ContentMasterMedia")
  thumbnailContentItems ContentItem[]     @relation("ContentThumbnailMedia")

  @@index([organizationId, status])
  @@index([projectId])
}

model WebsitePublication {
  id              String                   @id @default(cuid())
  organizationId  String
  mediaAssetId    String
  placement       WebsitePlacement
  status          WebsitePublicationStatus @default(DRAFT)
  title           String?
  description     String?
  altText         String?
  category        String?
  slug            String?
  sortOrder       Int                      @default(0)
  publishedAt     DateTime?
  unpublishedAt   DateTime?
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset               @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([organizationId, mediaAssetId, placement])
  @@index([organizationId, status, placement, sortOrder])
  @@index([mediaAssetId])
}

model PublicCategory {
  id             String              @id @default(cuid())
  organizationId String?
  slug           String              @unique
  name           String
  description    String?
  parentId       String?
  mediaAssetId   String?
  active         Boolean             @default(true)
  status         PublicProductStatus @default(PUBLISHED)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  parent         PublicCategory?     @relation("PublicCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       PublicCategory[]    @relation("PublicCategoryHierarchy")
  products       PublicProduct[]

  @@index([parentId, active])
  @@index([organizationId, status, sortOrder])
}

model VisualStyle {
  id             String               @id @default(cuid())
  organizationId String?
  slug           String               @unique
  name           String
  description    String?
  mediaAssetId   String?
  active         Boolean              @default(true)
  status         PublicProductStatus  @default(PUBLISHED)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?          @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  products       PublicProductStyle[]

  @@index([organizationId, status, sortOrder])
}

model PublicProduct {
  id               String                    @id @default(cuid())
  organizationId   String?
  slug             String                    @unique
  name             String
  shortDescription String
  fullDescription  String?
  categoryId       String
  productType      PublicProductType
  startingPrice    Int?
  pricingLabel     String?
  currency         String                    @default("INR")
  ctaLabel         String?
  ctaHref          String?
  features         Json?
  turnaround       String?
  duration         String?
  coverMediaAssetId String?
  status           PublicProductStatus       @default(DRAFT)
  featured         Boolean                   @default(false)
  displayOrder     Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  organization     Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         PublicCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverMediaAsset  MediaAsset?               @relation(fields: [coverMediaAssetId], references: [id], onDelete: SetNull)
  styles           PublicProductStyle[]
  media            PublicProductMedia[]
  collections      PublicCollectionProduct[]

  @@index([status, featured, displayOrder])
  @@index([categoryId, status, displayOrder])
  @@index([organizationId, status, displayOrder])
}

model PublicProductStyle {
  productId String
  styleId   String
  product   PublicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  style     VisualStyle   @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@id([productId, styleId])
  @@index([styleId])
}

model PublicProductMedia {
  id           String           @id @default(cuid())
  productId    String
  mediaAssetId String
  role         ProductMediaRole
  altText      String?
  displayOrder Int              @default(0)
  product      PublicProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaAssetId, role])
  @@index([productId, role, displayOrder])
}

model PublicCollection {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  name              String
  shortDescription  String?
  coverMediaAssetId String?
  active            Boolean                   @default(true)
  displayOrder      Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  products          PublicCollectionProduct[]

  @@index([active, displayOrder])
}

model PublicCollectionProduct {
  collectionId String
  productId    String
  displayOrder Int              @default(0)
  collection   PublicCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      PublicProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model PublicPlan {
  id             String              @id @default(cuid())
  organizationId String?
  slug           String              @unique
  name           String
  subtitle       String?
  description    String
  features       Json?
  ctaLabel       String?
  ctaHref        String?
  recommended    Boolean             @default(false)
  sortOrder      Int                 @default(0)
  status         PublicProductStatus @default(DRAFT)
  mediaAssetId   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, sortOrder])
  @@index([status, recommended, sortOrder])
}

model ContentItem {
  id              String            @id @default(cuid())
  organizationId  String
  title           String
  slug            String?
  description     String?
  contentType     ContentItemType
  status          ContentItemStatus @default(DRAFT)
  masterMediaId   String?
  thumbnailMediaId String?
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  masterMedia     MediaAsset?       @relation("ContentMasterMedia", fields: [masterMediaId], references: [id], onDelete: SetNull)
  thumbnailMedia  MediaAsset?       @relation("ContentThumbnailMedia", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("ContentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User              @relation("ContentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  destinations    ContentDestination[]
  jobs            PublishJob[]
  publications    PlatformPublication[]
  metricSnapshots ContentMetricSnapshot[]
  websiteEvents   WebsiteAnalyticsEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
  @@index([masterMediaId])
}

model ContentDestination {
  id            String                   @id @default(cuid())
  contentItemId String
  platform      ContentDestinationPlatform
  enabled       Boolean                  @default(false)
  status        ContentDestinationStatus @default(DRAFT)
  metadata      Json?
  scheduledFor  DateTime?
  publishedAt   DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  contentItem   ContentItem              @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  jobs          PublishJob[]
  publication   PlatformPublication?

  @@unique([contentItemId, platform])
  @@index([platform, status, scheduledFor])
}

model PublishJob {
  id              String            @id @default(cuid())
  organizationId  String
  contentItemId   String
  destinationId   String
  provider        ContentDestinationPlatform
  status          PublishJobStatus  @default(QUEUED)
  attempt         Int               @default(0)
  scheduledFor    DateTime?
  nextAttemptAt   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  lastErrorCode   String?
  lastErrorMessage String?
  idempotencyKey  String            @unique
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItem     ContentItem       @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  destination     ContentDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("PublishJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, scheduledFor])
  @@index([contentItemId, provider, status])
  @@index([destinationId, createdAt])
}

model PlatformPublication {
  id                  String                     @id @default(cuid())
  organizationId      String
  contentItemId       String
  destinationId       String                     @unique
  provider            ContentDestinationPlatform
  externalId          String?
  externalUrl         String?
  providerStatus      String?
  publishedAt         DateTime?
  metadata            Json?
  lastSyncedAt        DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItem         ContentItem                @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  destination         ContentDestination         @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  metricSnapshots     ContentMetricSnapshot[]

  @@unique([contentItemId, provider])
  @@index([organizationId, provider, publishedAt])
}

model ContentMetricSnapshot {
  id                    String                     @id @default(cuid())
  organizationId        String
  contentItemId         String
  platformPublicationId String?
  provider              ContentDestinationPlatform
  capturedAt            DateTime
  views                 Int?
  reach                 Int?
  impressions           Int?
  likes                 Int?
  comments              Int?
  shares                Int?
  saves                 Int?
  watchTimeSeconds      Int?
  averageViewDurationSeconds Int?
  clicks                Int?
  profileVisits         Int?
  subscribersGained     Int?
  subscribersLost       Int?
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItem           ContentItem                @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  platformPublication   PlatformPublication?       @relation(fields: [platformPublicationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, capturedAt])
  @@index([contentItemId, capturedAt])
  @@index([platformPublicationId, capturedAt])
}

model IntegrationConnection {
  id                    String                      @id @default(cuid())
  organizationId        String
  provider              ContentDestinationPlatform
  externalAccountId     String?
  externalAccountName   String?
  status                IntegrationConnectionStatus @default(NOT_CONNECTED)
  scopes                String[]
  tokenExpiresAt        DateTime?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  metadata              Json?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

model WebsiteAnalyticsEvent {
  id            String                    @id @default(cuid())
  organizationId String
  contentItemId String?
  eventType     WebsiteAnalyticsEventType
  path          String
  occurredAt    DateTime                  @default(now())
  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItem   ContentItem?              @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventType, occurredAt])
  @@index([contentItemId, occurredAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
